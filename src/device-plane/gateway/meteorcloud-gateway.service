[Unit]
Description=MeteorCloud WireGuard peer gateway
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/meteorcloud/gateway/connectivity_agent.py --interface wg0
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/meteorcloud/gateway.env

[Install]
WantedBy=multi-user.target
