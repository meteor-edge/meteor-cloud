# Copy to /etc/meteorcli-firstboot.env on the device (mode 0600).
# This is an enrollment API key (key_…), not a registration token (reg_…).
# The key only creates a pending request; an admin must still approve.

METEOR_DOMAIN=cloud.example.com
METEOR_API_KEY=key_replace_me

# Optional. Defaults to the hostname.
# METEOR_NAME=edge-01

# Seconds to poll per round (meteorcli claim --wait) in meteorcli-firstboot.service.
# Default 300. Repeats in the background until approved.
# METEOR_WAIT_SECONDS=300
