[Unit]
Description=MeteorCloud settings from the boot partition (Wi-Fi, hostname, timezone, SSH key)
Documentation=https://github.com/meteor-edge/meteor-cloud
# Early in boot, before the network and before first-boot enrollment, so the Wi-Fi
# network and host name are in place when they start. Does nothing without .meteorenv.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service wpa_supplicant.service dhcpcd.service ssh.service meteorcli-firstboot.service sysinit.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/meteorcli-settings.sh

[Install]
WantedBy=sysinit.target
