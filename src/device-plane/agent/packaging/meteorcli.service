[Unit]
Description=MeteorCloud device agent (meteorcli)
Documentation=https://github.com/meteor-edge/meteor-cloud
After=network-online.target
Wants=network-online.target
# Never let systemd give up restarting the agent.
StartLimitIntervalSec=0

[Service]
Type=simple
# System installs put the binary in /usr/local/bin. Override ExecStart if you
# installed for a user (~/.local/bin/meteorcli).
ExecStart=/usr/local/bin/meteorcli run
# always: the agent has no reason to stop; a crash or a clean exit both restart it.
Restart=always
RestartSec=10
# systemd / docker apply need privileges on Raspberry Pi OS. Run as root for
# fleet deploys, or drop capabilities carefully for heartbeat-only use.
User=root
Group=root
# Always /etc/meteorcli — enroll with ``sudo meteorcli …`` or re-run
# ``sudo ./installcli.sh`` to migrate ~/.config/meteorcli. Until the device is
# registered, ``meteorcli run`` waits here instead of exiting.
Environment=METEORCLI_CONFIG_DIR=/etc/meteorcli
# systemd's default PATH omits /snap/bin; Docker Desktop/snap installs land there.
# Without docker on PATH, heartbeats report docker/docker_compose=false and Deploys skip the device.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin

[Install]
WantedBy=multi-user.target
