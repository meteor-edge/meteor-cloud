[Unit]
Description=MeteorCloud device agent (meteorcli)
Documentation=https://github.com/meteor-edge/metero-cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# System installs put the binary in /usr/local/bin. Override ExecStart if you
# installed for a user (~/.local/bin/meteorcli).
ExecStart=/usr/local/bin/meteorcli run
Restart=on-failure
RestartSec=10
# systemd / docker apply need privileges on Raspberry Pi OS. Run as root for
# fleet deploys, or drop capabilities carefully for heartbeat-only use.
User=root
Group=root
Environment=METEORCLI_CONFIG_DIR=/etc/meteorcli

[Install]
WantedBy=multi-user.target
