{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/agent/software/secrets (request)",
  "description": "Values of spec.secret_env of a release deployed to this device.",
  "type": "object",
  "required": [
    "workload_key",
    "release_id"
  ],
  "properties": {
    "workload_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "release_id": {
      "$ref": "../common.json#/$defs/uuid"
    }
  }
}
