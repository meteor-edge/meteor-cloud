{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/agent/mqtt/credentials (200)",
  "description": "New broker credentials. password is a secret.",
  "allOf": [
    {
      "$ref": "../common.json#/$defs/mqtt_connect"
    }
  ],
  "type": "object",
  "required": [
    "host",
    "port",
    "username",
    "password",
    "config_version"
  ],
  "properties": {
    "config_version": {
      "type": "string"
    }
  }
}
