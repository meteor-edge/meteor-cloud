{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/agent/actions/report (request)",
  "description": "What happened to collected actions. reboot and shutdown are reported 'done' before they run.",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "$ref": "../common.json#/$defs/uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "done",
              "failed"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "output": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16000,
            "description": "run_diagnostics: the agent's doctor report as plain text, never a secret. Added in v1 (additive)."
          }
        }
      }
    }
  }
}
