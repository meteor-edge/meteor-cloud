{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/agent/applications/credentials (201)",
  "description": "token is a secret, handed to the workload in a file. Refresh after refresh_after.",
  "type": "object",
  "required": [
    "token",
    "credential_id",
    "expires_at",
    "endpoint",
    "application",
    "application_id",
    "organization_id",
    "device_id",
    "environment",
    "refresh_after"
  ],
  "properties": {
    "token": {
      "type": "string"
    },
    "credential_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "expires_at": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "application": {
      "type": "string"
    },
    "application_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "organization_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "device_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "environment": {
      "type": "string"
    },
    "refresh_after": {
      "$ref": "../common.json#/$defs/timestamp"
    }
  }
}
