{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devices/{device_id}/events (device to server)",
  "description": "QoS 1, not retained. One message per event: app lifecycle changes and system warnings from the journal.",
  "type": "object",
  "required": [
    "type",
    "timestamp"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string"
    },
    "app": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^app\\."
          }
        }
      },
      "then": {
        "required": [
          "app"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "log"
          }
        }
      },
      "then": {
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000
          },
          "priority": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  ]
}
