{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteorcloud.dev/contracts/rules-v1.schema.json",
  "title": "MeteorCloud rule definition, version 1",
  "description": "Mirrors the Go validator in src/data-plane/go/internal/rules/dsl, which is the authority (it also enforces depth 8, 64 nodes, window bounds 1s-24h, min<=max and one alert action). See contracts/rules-v1.md.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "scope",
    "condition"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "enabled": {
      "type": "boolean"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streams": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*$"
          }
        }
      }
    },
    "condition": {
      "$ref": "#/$defs/node"
    },
    "resolve": {
      "$ref": "#/$defs/node"
    },
    "cooldown": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "alerting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "single",
            "per_event"
          ]
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "late_tolerance": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "comparison",
            "all",
            "any",
            "not",
            "duration",
            "count_within",
            "consecutive",
            "aggregate",
            "absence"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "between",
            "in",
            "not_in",
            "exists",
            "not_exists"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "maxLength": 256
            }
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 256
              }
            ]
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "condition": {
          "$ref": "#/$defs/node"
        },
        "duration": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "window": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "function": {
          "enum": [
            "avg",
            "min",
            "max",
            "sum",
            "count",
            "delta",
            "rate"
          ]
        },
        "streams": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*$"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "comparison"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "operator"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "field",
                "operator",
                "value",
                "values",
                "min",
                "max"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "all"
              }
            }
          },
          "then": {
            "required": [
              "conditions"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "any"
              }
            }
          },
          "then": {
            "required": [
              "conditions"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "not"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "condition"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "duration"
              }
            }
          },
          "then": {
            "required": [
              "duration",
              "condition"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "duration",
                "condition"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "count_within"
              }
            }
          },
          "then": {
            "required": [
              "window",
              "min_count",
              "condition"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "window",
                "min_count",
                "condition"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "consecutive"
              }
            }
          },
          "then": {
            "required": [
              "count",
              "condition"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "count",
                "condition"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aggregate"
              }
            }
          },
          "then": {
            "required": [
              "function",
              "field",
              "window",
              "operator"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "function",
                "field",
                "window",
                "operator",
                "value",
                "min",
                "max"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "absence"
              }
            }
          },
          "then": {
            "required": [
              "duration"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "duration",
                "streams"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "between"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "alert",
            "webhook",
            "command",
            "notification",
            "platform_event"
          ]
        },
        "on": {
          "type": "array",
          "items": {
            "enum": [
              "firing",
              "resolved"
            ]
          },
          "maxItems": 2
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "integration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "params": {
          "type": "object"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "webhook",
                  "notification"
                ]
              }
            }
          },
          "then": {
            "required": [
              "integration_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "device",
            "group",
            "device_type",
            "organization",
            "platform"
          ]
        },
        "device_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "device_type_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "device"
              }
            }
          },
          "then": {
            "required": [
              "device_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "group_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "device_type"
              }
            }
          },
          "then": {
            "required": [
              "device_type_id"
            ]
          }
        }
      ]
    }
  }
}
