# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Misc
*.bak

# Local MQTT TLS material (private keys must never be committed)
certs/*
!certs/.gitkeep

# Ansible inventories with real hosts (keep the example)
deploy/ansible/inventory/*
!deploy/ansible/inventory/example*/

# Local k3d MQTT certificates
.k8s/

# Ansible WireGuard gateway hand-off files (contain public keys and endpoints)
deploy/ansible/artifacts/

# MeteorCloud E2E environments (state, keys, generated secrets, reports)
tests/e2e/.env
tests/e2e/.state/
tests/e2e/terraform/*/.terraform-validate/
