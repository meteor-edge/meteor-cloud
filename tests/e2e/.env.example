# MeteorCloud full-stack E2E settings. Copy to tests/e2e/.env (gitignored) and edit.
# Environment variables with the same names override this file. Never put secrets here:
# platform secrets are generated per environment into .state/<env>/secrets.env (0600).

# Unique name: prefixes every cloud resource and the DNS subdomain (<name>.<E2E_DOMAIN>).
E2E_ENV_NAME=dev-yourname

# aws (Terraform creates the hosts) or onprem (existing hosts below).
E2E_PROVIDER=aws
E2E_AWS_REGION=eu-central-1
# AWS credentials come from the usual AWS_* variables / AWS_PROFILE.

# same_host (WireGuard on the control plane) or dedicated (a separate gateway host).
E2E_VPN_PLACEMENT=same_host
# Simulated devices (2+ for the second-device, routing and isolation checks).
E2E_DEVICE_COUNT=2

# Networks allowed to SSH to the hosts. Empty: your current public IP/32. /0 is rejected.
E2E_ALLOWED_SSH_CIDRS=

# Public DNS + HTTPS. Without them the DNS, TLS and public-app checks are BLOCKED (the run fails).
#   route53: Terraform creates <env>.<domain> and *.appx.<env>.<domain> in this zone and gives
#            Traefik an instance role limited to the ACME TXT records.
#   manual:  you create both A records (pointing at the control plane) before `up`.
E2E_DNS_PROVIDER=route53
E2E_DNS_ZONE_ID=
E2E_DOMAIN=
# Optional Let's Encrypt account contact.
E2E_ACME_EMAIL=

# Instance sizes (AWS).
# E2E_CONTROL_PLANE_INSTANCE_TYPE=t3.medium
# E2E_GATEWAY_INSTANCE_TYPE=t3.micro
# E2E_DEVICE_INSTANCE_TYPE=t3.micro

# On-prem (E2E_PROVIDER=onprem): user@host[,private_ip]; devices separated by ';'.
# E2E_ONPREM_CONTROL_PLANE=ubuntu@203.0.113.10
# E2E_ONPREM_GATEWAY=ubuntu@203.0.113.11,10.0.0.11
# E2E_ONPREM_DEVICES=pi@203.0.113.20;pi@203.0.113.21
# E2E_SSH_KEY_FILE=~/.ssh/meteorcloud-lab
# Public address that DNS should point at (router port-forward of 80/443 to the control plane).
# E2E_ONPREM_INGRESS_IP=203.0.113.10
# DNS-01 off AWS: export EDGE_PLATFORM_TRAEFIK_AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY (scoped IAM key).

# Extra CA bundle to trust (internal CA). TLS verification is never turned off.
# E2E_CA_FILE=
