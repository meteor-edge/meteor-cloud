variable "env_name" {
  description = "E2E environment name; prefixes every resource and the DNS subdomain."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,23}$", var.env_name))
    error_message = "env_name: 3-24 characters, lowercase letters, digits and hyphens."
  }
}

variable "aws_region" {
  type = string
}

variable "ssh_public_key" {
  description = "Public half of the per-environment SSH key (generated by meteorcloud-testenv)."
  type        = string
}

variable "allowed_ssh_cidrs" {
  description = "Operator networks allowed to SSH to the hosts. 0.0.0.0/0 is rejected."
  type        = list(string)

  validation {
    condition     = length(var.allowed_ssh_cidrs) > 0 && alltrue([for c in var.allowed_ssh_cidrs : !endswith(c, "/0")])
    error_message = "allowed_ssh_cidrs must list specific networks; /0 is not allowed."
  }
}

variable "vpn_placement" {
  type    = string
  default = "same_host"

  validation {
    condition     = contains(["same_host", "dedicated"], var.vpn_placement)
    error_message = "vpn_placement must be same_host or dedicated."
  }
}

variable "device_count" {
  type    = number
  default = 2

  validation {
    condition     = var.device_count >= 1 && var.device_count <= 5
    error_message = "device_count must be 1-5."
  }
}

variable "control_plane_instance_type" {
  type    = string
  default = "t3.medium"
}

variable "gateway_instance_type" {
  type    = string
  default = "t3.micro"
}

variable "device_instance_type" {
  type    = string
  default = "t3.micro"
}

variable "dns_provider" {
  description = "route53: Terraform creates the records and Traefik's DNS-01 role. manual or none: it creates neither."
  type        = string
  default     = "route53"

  validation {
    condition     = contains(["route53", "manual", "none"], var.dns_provider)
    error_message = "dns_provider must be route53, manual or none."
  }
}

variable "dns_zone_id" {
  type    = string
  default = ""
}

variable "domain" {
  description = "Zone apex; the environment uses <env_name>.<domain> and *.<env_name>.<domain> for apps."
  type        = string
  default     = ""
}
