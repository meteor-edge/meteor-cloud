{
  "scenario": "heartbeat",
  "contract": "contracts/device-agent-v1.md",
  "http": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/agent/register",
        "headers": {
          "user-agent": "meteorcli/<version>",
          "x-meteor-agent-protocol": "1"
        },
        "body": {
          "agent_version": "<inventory>",
          "architecture": "<inventory>",
          "cpu_cores": "<inventory>",
          "cpu_model": "<inventory>",
          "hardware_model": "<inventory>",
          "hostname": "<inventory>",
          "kernel_version": "<inventory>",
          "local_ip": "<inventory>",
          "mac_addresses": "<inventory>",
          "memory_mb": "<inventory>",
          "os_name": "<inventory>",
          "os_version": "<inventory>",
          "serial_number": "<inventory>",
          "token": "<registration_token>"
        }
      },
      "response": {
        "status": 201,
        "headers": {},
        "body": {
          "device_id": "<uuid:1>",
          "device_token": "<device_token>",
          "organization_id": "<uuid:2>",
          "name": "contract-device",
          "heartbeat_interval_seconds": 60,
          "mqtt": null
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/agent/heartbeat",
        "headers": {
          "authorization": "Bearer <device_token>",
          "user-agent": "meteorcli/<version>",
          "x-meteor-agent-protocol": "1"
        },
        "body": {
          "agent_version": "<inventory>",
          "architecture": "<inventory>",
          "capabilities": {
            "systemd": true,
            "docker": true,
            "docker_compose": true,
            "wireguard": true,
            "ssh": true,
            "actions": [],
            "deploy_kinds": [],
            "modules": {
              "heartbeat": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              },
              "identity": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              },
              "socket": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              }
            }
          },
          "cpu_cores": "<inventory>",
          "cpu_model": "<inventory>",
          "hardware_model": "<inventory>",
          "hostname": "<inventory>",
          "kernel_version": "<inventory>",
          "local_ip": "<inventory>",
          "mac_addresses": "<inventory>",
          "memory_mb": "<inventory>",
          "os_name": "<inventory>",
          "os_version": "<inventory>",
          "serial_number": "<inventory>"
        }
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "device_id": "<uuid:1>",
          "status": "online",
          "heartbeat_interval_seconds": 5,
          "server_time": "<timestamp>",
          "desired_software": [],
          "wifi_pending": false,
          "actions_pending": false
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/agent/heartbeat",
        "headers": {
          "authorization": "Bearer <device_token>",
          "user-agent": "meteorcli/<version>",
          "x-meteor-agent-protocol": "1"
        },
        "body": {
          "agent_version": "<inventory>",
          "architecture": "<inventory>",
          "capabilities": {
            "systemd": true,
            "docker": true,
            "docker_compose": true,
            "wireguard": true,
            "ssh": true,
            "actions": [],
            "deploy_kinds": [],
            "modules": {
              "heartbeat": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              },
              "identity": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              },
              "socket": {
                "state": "running",
                "restarts": 0,
                "since": "<timestamp>"
              }
            }
          },
          "cpu_cores": "<inventory>",
          "cpu_model": "<inventory>",
          "hardware_model": "<inventory>",
          "hostname": "<inventory>",
          "kernel_version": "<inventory>",
          "local_ip": "<inventory>",
          "mac_addresses": "<inventory>",
          "memory_mb": "<inventory>",
          "os_name": "<inventory>",
          "os_version": "<inventory>",
          "serial_number": "<inventory>"
        }
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "device_id": "<uuid:1>",
          "status": "online",
          "heartbeat_interval_seconds": 60,
          "server_time": "<timestamp>",
          "desired_software": [],
