# WireGuard settings for a MeteorCloud control plane that uses the gateway
# {{ vpn_gateway_host }}. Add them to the API environment (Compose .env).
# Also set CONNECTIVITY_INTERNAL_TOKEN to the same value as the gateway
# (EDGE_PLATFORM_CONNECTIVITY_INTERNAL_TOKEN), and make the API reachable from
# the gateway at {{ vpn_agent_control_plane_url | trim }} (never publicly).
CONNECTIVITY_PROVIDER=wireguard
WIREGUARD_SERVER_PUBLIC_KEY={{ vpn_server_public_key }}
WIREGUARD_SERVER_ENDPOINT={{ vpn_gateway_endpoint | trim }}
WIREGUARD_SERVER_ADDRESS={{ vpn_server_address }}
WIREGUARD_CLIENT_CIDR={{ vpn_network_cidr }}
