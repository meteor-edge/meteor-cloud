CONNECTIVITY_INTERNAL_TOKEN={{ connectivity_internal_token }}
CONTROL_PLANE_URL={{ vpn_agent_control_plane_url | trim }}
{% set static_peers = (vpn_managed_api_hosts | map('extract', hostvars, 'vpn_link_public_key') | list) + (vpn_site_links | map(attribute='public_key') | list) %}
{% if static_peers %}
GATEWAY_STATIC_PEERS={{ static_peers | join(',') }}
{% endif %}
