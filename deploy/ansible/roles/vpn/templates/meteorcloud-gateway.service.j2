[Unit]
Description=MeteorCloud WireGuard peer gateway
Documentation=file:///opt/meteorcloud/gateway/connectivity_agent.py
After=network-online.target wg-quick@wg0.service docker.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
EnvironmentFile=-/etc/meteorcloud/gateway.env
ExecStart=/usr/bin/python3 /opt/meteorcloud/gateway/connectivity_agent.py --interface wg0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
