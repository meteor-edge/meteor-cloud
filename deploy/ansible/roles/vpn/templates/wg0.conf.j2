# Managed by Ansible (MeteorCloud vpn role).
[Interface]
Address = {{ vpn_server_address }}
ListenPort = {{ vpn_listen_port }}
# The private key stays in /etc/wireguard/server.key, never in this file.
PostUp = wg set %i private-key /etc/wireguard/server.key
# Device peers are applied at runtime by the MeteorCloud gateway agent (`wg set`).
# Do not add device [Peer] blocks here; the agent would remove them on its next sync.
{% if vpn_standalone | bool %}
{% set sources = ([vpn_link_subnet] if (vpn_managed_api_hosts or vpn_site_links) else []) + vpn_routed_cidrs %}
# Dedicated gateway. Only these sources may open connections to devices, and
# they are NATed to {{ vpn_server_address.split('/')[0] }} (devices accept only that address):
#   {{ sources | join(', ') if sources else '(none)' }}
# Devices cannot open connections anywhere (gateway, other devices, internet);
# replies to established connections pass.
PostUp = iptables -I FORWARD -o %i -j DROP; iptables -I FORWARD -i %i -j DROP; iptables -I FORWARD -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT; iptables -I INPUT -i %i -m conntrack --ctstate NEW,INVALID -j DROP
PostDown = iptables -D FORWARD -o %i -j DROP; iptables -D FORWARD -i %i -j DROP; iptables -D FORWARD -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT; iptables -D INPUT -i %i -m conntrack --ctstate NEW,INVALID -j DROP
{% for source in sources %}
PostUp = iptables -I FORWARD -o %i -s {{ source }} -j ACCEPT; iptables -t nat -A POSTROUTING -o %i -s {{ source }} -j MASQUERADE
PostDown = iptables -D FORWARD -o %i -s {{ source }} -j ACCEPT; iptables -t nat -D POSTROUTING -o %i -s {{ source }} -j MASQUERADE
{% endfor %}
{% for host in vpn_managed_api_hosts %}

# Site link: {{ host }}
[Peer]
PublicKey = {{ hostvars[host].vpn_link_public_key }}
AllowedIPs = {{ vpn_link_prefix }}.{{ loop.index0 + 2 }}/32
{% endfor %}
{% for link in vpn_site_links %}

# Site link: {{ link.name }} (unmanaged control-plane host)
[Peer]
PublicKey = {{ link.public_key }}
AllowedIPs = {{ link.address }}/32
{% endfor %}
{% else %}
# Co-located with the API. Same isolation as a dedicated gateway: devices only answer.
#   FORWARD (top): replies from devices pass, every other packet from a device is dropped,
#     including device -> device (it enters and leaves %i) and device -> internet.
#   FORWARD (end): this host and its containers may open connections to devices.
#   INPUT: devices cannot open connections to this host (its sshd, Traefik, ...).
#   DOCKER-USER: the same for traffic to containers (Docker's FORWARD rules run first).
PostUp = iptables -I FORWARD -i %i -j DROP; iptables -I FORWARD -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT; iptables -A FORWARD -o %i -j ACCEPT; iptables -I INPUT -i %i -m conntrack --ctstate NEW,INVALID -j DROP; sysctl -w net.ipv4.ip_forward=1; iptables -I DOCKER-USER -o %i -j ACCEPT || true; iptables -I DOCKER-USER -i %i -j DROP || true; iptables -I DOCKER-USER -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || true
PostDown = iptables -D FORWARD -i %i -j DROP; iptables -D FORWARD -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT; iptables -D FORWARD -o %i -j ACCEPT; iptables -D INPUT -i %i -m conntrack --ctstate NEW,INVALID -j DROP; iptables -D DOCKER-USER -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || true; iptables -D DOCKER-USER -i %i -j DROP || true; iptables -D DOCKER-USER -o %i -j ACCEPT || true
{% endif %}
