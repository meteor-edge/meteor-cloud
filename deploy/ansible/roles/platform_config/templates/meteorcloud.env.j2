# Managed by Ansible (deploy/ansible). Same keys as deploy/compose/.env.example.
{% set profiles = [] %}
{% if postgres_provider == 'bundled' %}{% set _ = profiles.append('postgres') %}{% endif %}
{% if cache_provider == 'redis' and redis_provider == 'bundled' %}{% set _ = profiles.append('redis') %}{% endif %}
{% if object_storage_provider == 's3' and minio_enabled | bool %}{% set _ = profiles.append('minio') %}{% endif %}
{% if mqtt_enabled | bool %}{% set _ = profiles.append('mqtt') %}{% endif %}
{% if mqtt_enabled | bool and mqtt_broker == 'bundled' %}{% set _ = profiles.append('emqx') %}{% endif %}
{% set pull_policy = {'always': 'always', 'if-not-present': 'missing', 'never': 'never'}[image_pull_policy] | default('missing') %}
COMPOSE_PROFILES={{ profiles | join(',') }}
COMPOSE_PROJECT_NAME={{ compose_project_name }}
COMPOSE_NETWORK_NAME={{ compose_project_name }}

# Images and host paths
BACKEND_IMAGE={{ backend_image }}
DATA_PLANE_IMAGE={{ data_plane_image }}
CONSOLE_IMAGE={{ frontend_image }}
IMAGE_PULL_POLICY={{ 'never' if image_source == 'git' else pull_policy }}
METEORCLOUD_SOURCE_DIR={{ platform_source_dir }}
POSTGRES_DATA={{ platform_root }}/data/postgres
REDIS_DATA={{ platform_root }}/data/redis
MINIO_DATA={{ platform_root }}/data/minio
ARTIFACTS_DATA={{ platform_root }}/data/artifacts
PROMETHEUS_DATA={{ platform_root }}/data/prometheus
TRAEFIK_ACME_DATA={{ platform_root }}/traefik
MQTT_CERTS_DIR={{ platform_certs_dir }}

# Entry point
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}
PLATFORM_DOMAIN={{ platform_domain }}
ACME_EMAIL={{ acme_email }}
BACKEND_CORS_ORIGINS={{ platform_public_url }}
VITE_DOCS_BASE_URL={{ docs_public_url }}

# Database
DATABASE_PROVIDER=postgresql
POSTGRES_USER={{ postgres_username }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_database }}
{% if postgres_provider == 'external' %}
DATABASE_URL={{ external_database_url }}
{% endif %}

# Rate limiting
CACHE_PROVIDER={{ cache_provider }}
{% if cache_provider == 'redis' %}
REDIS_URL={{ external_redis_url if redis_provider == 'external' else 'redis://redis:6379/0' }}
{% endif %}

# Artifact storage
OBJECT_STORAGE_PROVIDER={{ object_storage_provider }}
OBJECT_STORAGE_ENDPOINT_URL={{ 'http://minio:9000' if minio_enabled | bool else object_storage_endpoint_url }}
OBJECT_STORAGE_REGION={{ object_storage_region }}
OBJECT_STORAGE_BUCKET={{ object_storage_bucket }}
OBJECT_STORAGE_AUTO_CREATE_BUCKET={{ object_storage_auto_create_bucket | bool | lower }}
OBJECT_STORAGE_ACCESS_KEY_ID={{ object_storage_access_key_id }}
OBJECT_STORAGE_SECRET_ACCESS_KEY={{ object_storage_secret_access_key }}

# MQTT
MQTT_ENABLED={{ mqtt_enabled | bool | lower }}
MQTT_PROVIDER=emqx
MQTT_BROKER_HOST={{ 'emqx' if mqtt_broker == 'bundled' else mqtt_broker_host }}
MQTT_BROKER_PORT={{ mqtt_broker_port }}
MQTT_PORT={{ mqtt_broker_port }}
MQTT_PUBLIC_HOST={{ mqtt_public_host }}
MQTT_PLATFORM_USERNAME=platform
MQTT_PLATFORM_PASSWORD={{ mqtt_platform_password }}
MQTT_INTERNAL_TOKEN={{ mqtt_internal_token }}
TELEMETRY_PROVIDER=postgresql
OTA_PROVIDER=none
IDENTITY_PROVIDER=local

# Secrets
APP_SECRET_KEY={{ jwt_secret }}
JWT_SECRET_KEY={{ jwt_secret }}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
{% if admin_email and admin_password %}
EDGE_PLATFORM_ADMIN_EMAIL={{ admin_email }}
EDGE_PLATFORM_ADMIN_PASSWORD={{ admin_password }}
{% endif %}
{% if observability_enabled | bool %}
GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
{% endif %}

# Application
APP_NAME=edge-platform
APP_ENV={{ platform_env }}
APP_DEBUG=false
PLATFORM_VERSION={{ platform_version }}
LOG_LEVEL={{ log_level }}
LOG_FORMAT={{ log_format }}
OBSERVABILITY_BACKEND={{ observability_backend }}
REGISTRATION_REQUIRE_HTTPS={{ registration_require_https | bool | lower }}
DEVICE_HEARTBEAT_INTERVAL_SECONDS={{ device_heartbeat_interval_seconds | default(60) }}
DEVICE_OFFLINE_THRESHOLD_SECONDS={{ device_offline_threshold_seconds | default(150) }}
REGISTRATION_RATE_LIMIT_REQUESTS={{ registration_rate_limit_requests | default(10) }}
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS={{ registration_rate_limit_window_seconds | default(60) }}
ENROLLMENT_REQUEST_RATE_LIMIT_REQUESTS={{ enrollment_request_rate_limit_requests | default(5) }}
ENROLLMENT_REQUEST_RATE_LIMIT_WINDOW_SECONDS={{ enrollment_request_rate_limit_window_seconds | default(60) }}
ENROLLMENT_POLL_RATE_LIMIT_REQUESTS={{ enrollment_poll_rate_limit_requests | default(30) }}
ENROLLMENT_POLL_RATE_LIMIT_WINDOW_SECONDS={{ enrollment_poll_rate_limit_window_seconds | default(60) }}
ENROLLMENT_POLL_INTERVAL_SECONDS={{ enrollment_poll_interval_seconds | default(10) }}
ENROLLMENT_REQUEST_TTL_SECONDS={{ enrollment_request_ttl_seconds | default(3600) }}
