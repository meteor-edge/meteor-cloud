# MeteorCloud Docker Compose configuration.
#   cp .env.example .env
# Compose reads this file for ${...} interpolation and passes it to the
# backend and data-plane containers. Hostnames are Compose service names.
# Never commit .env. Production values are rendered by Ansible (deploy/ansible).

# ---------------------------------------------------------------------------
# Infrastructure selection: which bundled services Compose starts.
# ---------------------------------------------------------------------------
#   postgres  bundled PostgreSQL          (omit and set DATABASE_URL for an external server)
#   redis     bundled Redis               (omit and use CACHE_PROVIDER=memory or an external REDIS_URL)
#   minio     bundled S3-compatible store (omit and use filesystem storage or external S3)
#   mqtt      data-plane MQTT gateway     (needed whenever MQTT_ENABLED=true)
#   emqx      bundled EMQX broker         (omit and set MQTT_BROKER_HOST for an external EMQX)
COMPOSE_PROFILES=postgres,redis,minio,mqtt,emqx

# Database (PostgreSQL is required; bundled or external)
POSTGRES_USER=edge
POSTGRES_DB=edge_platform
# External PostgreSQL instead of the bundled one:
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/meteorcloud

# Rate limiting: redis (shared across API replicas) or memory (single API replica)
CACHE_PROVIDER=redis
REDIS_URL=redis://redis:6379/0

# Artifact storage: s3 (AWS S3 or any S3-compatible API) or filesystem
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=meteorcloud-artifacts
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# AWS S3: leave the endpoint and keys empty to use the default AWS endpoint and
# credential chain (e.g. an EC2 instance role).
# GCS: OBJECT_STORAGE_ENDPOINT_URL=https://storage.googleapis.com with HMAC keys.
# Filesystem (no object store needed; data lives in the artifacts_data volume):
# OBJECT_STORAGE_PROVIDER=filesystem

# MQTT broker (EMQX with HTTP auth callbacks to the control plane)
MQTT_ENABLED=true
MQTT_PROVIDER=emqx
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=8883
# Address devices use to reach the broker. LAN devices need a reachable address
# (not localhost); `make mqtt-certs` adds this machine's LAN IP to the cert SAN.
MQTT_PUBLIC_HOST=localhost
MQTT_PLATFORM_USERNAME=platform
MQTT_PING_TIMEOUT_SECONDS=8
TELEMETRY_PROVIDER=postgresql
OTA_PROVIDER=none
IDENTITY_PROVIDER=local
DATABASE_PROVIDER=postgresql

# ---------------------------------------------------------------------------
# Secrets. The values below are for local development only.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=edge
APP_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key-must-be-long
MQTT_PLATFORM_PASSWORD=dev-mqtt-platform
MQTT_INTERNAL_TOKEN=dev-mqtt-internal
# MinIO root credentials when the minio profile is on; S3 keys otherwise.
OBJECT_STORAGE_ACCESS_KEY_ID=meteorcloud
OBJECT_STORAGE_SECRET_ACCESS_KEY=meteorcloud-dev-secret
# Optional first administrator (created by `python -m app.cli create-admin`).
# EDGE_PLATFORM_ADMIN_EMAIL=
# EDGE_PLATFORM_ADMIN_PASSWORD=
# Required only with docker-compose.observability.yml
# GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=edge-platform
APP_ENV=development
APP_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
LOG_FORMAT=console
OBSERVABILITY_BACKEND=prometheus

DEVICE_HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_OFFLINE_THRESHOLD_SECONDS=150
REGISTRATION_RATE_LIMIT_REQUESTS=10
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
# Set true to reject device registration over plain HTTP (recommended in production)
REGISTRATION_REQUIRE_HTTPS=false
ENROLLMENT_REQUEST_RATE_LIMIT_REQUESTS=5
ENROLLMENT_REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
ENROLLMENT_POLL_RATE_LIMIT_REQUESTS=30
ENROLLMENT_POLL_RATE_LIMIT_WINDOW_SECONDS=60
ENROLLMENT_POLL_INTERVAL_SECONDS=10
ENROLLMENT_REQUEST_TTL_SECONDS=3600
# 8 GiB. Uploads are spooled to a temp file on the API host before storage.
ARTIFACT_MAX_UPLOAD_BYTES=8589934592
ARTIFACT_DOWNLOAD_LINK_TTL_SECONDS=300

# Console dev server (browser -> control-plane API). Production builds call the
# API on the same origin.
VITE_API_BASE_URL=http://localhost:8000
VITE_DOCS_BASE_URL=http://localhost:3000/docs

# ---------------------------------------------------------------------------
# Production overlay (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# PLATFORM_DOMAIN=fleet.example.com   # enables HTTPS via Let's Encrypt
# ACME_EMAIL=ops@example.com
# BACKEND_IMAGE=ghcr.io/your-org/meteorcloud-backend:0.2.0
# DATA_PLANE_IMAGE=ghcr.io/your-org/meteorcloud-data-plane:0.2.0
# CONSOLE_IMAGE=ghcr.io/your-org/meteorcloud-console:0.2.0
# IMAGE_PULL_POLICY=always
# Host paths instead of named volumes, e.g. POSTGRES_DATA=/srv/meteorcloud/postgres
# MQTT_CERTS_DIR=/srv/meteorcloud/certs   # ca.crt, server.crt, server.key
