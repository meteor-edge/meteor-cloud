# Application
APP_NAME=edge-platform
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-key

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=edge
POSTGRES_PASSWORD=edge
POSTGRES_DB=edge_platform
DATABASE_URL=postgresql+psycopg://edge:edge@localhost:5432/edge_platform
# Provider selection (only these values are implemented)
DATABASE_PROVIDER=postgresql
CACHE_PROVIDER=redis
MQTT_PROVIDER=emqx
OTA_PROVIDER=none
# Pytest always uses a sibling *_test database (never DATABASE_URL above).
# Override the derived URL only if you need a different test database:
# TEST_DATABASE_URL=postgresql+psycopg://edge:edge@localhost:5432/edge_platform_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-must-be-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Fleet / device connectivity
DEVICE_HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_OFFLINE_THRESHOLD_SECONDS=150
# Device registration rate limit (fixed window per source IP)
REGISTRATION_RATE_LIMIT_REQUESTS=10
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
# Set true to reject device registration over plain HTTP (recommended in prod)
REGISTRATION_REQUIRE_HTTPS=false
# Device-initiated enrollment (request -> approve -> claim)
ENROLLMENT_REQUEST_RATE_LIMIT_REQUESTS=5
ENROLLMENT_REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
ENROLLMENT_POLL_RATE_LIMIT_REQUESTS=30
ENROLLMENT_POLL_RATE_LIMIT_WINDOW_SECONDS=60
ENROLLMENT_POLL_INTERVAL_SECONDS=10
ENROLLMENT_REQUEST_TTL_SECONDS=3600

# MQTT (local EMQX over TLS)
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_PUBLIC_HOST=localhost
# LAN devices: set this to an address they can reach (not localhost).
# `make mqtt-certs` also adds this machine's LAN IP to the broker cert SAN.
MQTT_BROKER_PORT=8883
MQTT_PLATFORM_USERNAME=platform
MQTT_PLATFORM_PASSWORD=dev-mqtt-platform
MQTT_INTERNAL_TOKEN=dev-mqtt-internal
MQTT_CA_CERT_PATH=certs/ca.crt
MQTT_PING_TIMEOUT_SECONDS=8

# Plane split (Compose service names when running together)
DATA_PLANE_URL=http://127.0.0.1:8081
CONTROL_PLANE_URL=http://127.0.0.1:8000
TELEMETRY_PROVIDER=postgresql
HTTP_ADDR=:8081

# Object storage for artifacts (OS images, firmware). Any S3-compatible API.
# Local Compose runs MinIO (API :9000, UI :9001 — meteorcloud / meteorcloud-dev-secret).
# For AWS S3 leave the endpoint and keys empty to use the default AWS endpoint
# and credential chain (e.g. the instance role).
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=meteorcloud-artifacts
OBJECT_STORAGE_ACCESS_KEY_ID=meteorcloud
OBJECT_STORAGE_SECRET_ACCESS_KEY=meteorcloud-dev-secret
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# 8 GiB. Uploads are spooled to a temp file on the API host before storage.
ARTIFACT_MAX_UPLOAD_BYTES=8589934592
ARTIFACT_DOWNLOAD_LINK_TTL_SECONDS=300

# Logging / observability (app emits JSON or console; sink is chosen at install)
LOG_LEVEL=INFO
LOG_FORMAT=console
# prometheus (default) or cloudwatch (reserved; not implemented in the app)
OBSERVABILITY_BACKEND=prometheus

# Console (browser → control-plane API only)
VITE_API_BASE_URL=http://localhost:8000
# Public docs site (separate Next.js app)
VITE_DOCS_BASE_URL=http://localhost:3000/docs

# Public website (separate Next.js app; not the operator console)
SITE_URL=http://localhost:3000
WEBSITE_CONTENT_SOURCE=filesystem
# CONTACT_WEBHOOK_URL=
