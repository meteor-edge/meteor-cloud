# MeteorCloud data API, e.g. https://data.cloud.example.com. "meteorcloud" is this machine (see docker-compose.yml).
METEORCLOUD_ENDPOINT=http://meteorcloud:8082
# Streams to copy: names (energy.metrics) or patterns (energy.*, energy.**), comma separated.
SINK_STREAMS=energy.metrics
# telemetry, events, inference (comma separated)
SINK_KINDS=telemetry
# How far back the first start copies history, and how often the sweep runs.
SINK_BACKFILL=1h
SINK_SWEEP_INTERVAL=60s
LOG_LEVEL=INFO
