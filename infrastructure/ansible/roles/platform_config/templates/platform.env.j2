APP_NAME=edge-platform
APP_ENV={{ platform_env }}
APP_SECRET_KEY={{ EDGE_PLATFORM_JWT_SECRET | default(lookup('env', 'EDGE_PLATFORM_JWT_SECRET'), true) }}

DATABASE_URL=postgresql+psycopg://{{ postgres_username }}:{{ EDGE_PLATFORM_POSTGRES_PASSWORD | default(lookup('env', 'EDGE_PLATFORM_POSTGRES_PASSWORD'), true) }}@postgres:5432/{{ postgres_database }}
DATABASE_PROVIDER=postgresql
CACHE_PROVIDER=redis
MQTT_PROVIDER=emqx
OTA_PROVIDER=none
TELEMETRY_PROVIDER=postgresql
DATA_PLANE_URL=http://data-plane:8081
POSTGRES_USER={{ postgres_username }}
POSTGRES_PASSWORD={{ EDGE_PLATFORM_POSTGRES_PASSWORD | default(lookup('env', 'EDGE_PLATFORM_POSTGRES_PASSWORD'), true) }}
POSTGRES_DB={{ postgres_database }}

REDIS_URL=redis://{% if (EDGE_PLATFORM_REDIS_PASSWORD | default(lookup('env', 'EDGE_PLATFORM_REDIS_PASSWORD') | default('', true), true)) %}:{{ EDGE_PLATFORM_REDIS_PASSWORD | default(lookup('env', 'EDGE_PLATFORM_REDIS_PASSWORD'), true) }}@{% endif %}redis:6379/0

JWT_SECRET_KEY={{ EDGE_PLATFORM_JWT_SECRET | default(lookup('env', 'EDGE_PLATFORM_JWT_SECRET'), true) }}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

DEVICE_HEARTBEAT_INTERVAL_SECONDS={{ device_heartbeat_interval_seconds | default(60) }}
DEVICE_OFFLINE_THRESHOLD_SECONDS={{ device_offline_threshold_seconds | default(150) }}
REGISTRATION_RATE_LIMIT_REQUESTS={{ registration_rate_limit_requests | default(10) }}
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS={{ registration_rate_limit_window_seconds | default(60) }}
REGISTRATION_REQUIRE_HTTPS={{ registration_require_https | default('false') }}
ENROLLMENT_REQUEST_RATE_LIMIT_REQUESTS={{ enrollment_request_rate_limit_requests | default(5) }}
ENROLLMENT_REQUEST_RATE_LIMIT_WINDOW_SECONDS={{ enrollment_request_rate_limit_window_seconds | default(60) }}
ENROLLMENT_POLL_RATE_LIMIT_REQUESTS={{ enrollment_poll_rate_limit_requests | default(30) }}
ENROLLMENT_POLL_RATE_LIMIT_WINDOW_SECONDS={{ enrollment_poll_rate_limit_window_seconds | default(60) }}
ENROLLMENT_POLL_INTERVAL_SECONDS={{ enrollment_poll_interval_seconds | default(10) }}
ENROLLMENT_REQUEST_TTL_SECONDS={{ enrollment_request_ttl_seconds | default(3600) }}

BACKEND_CORS_ORIGINS={{ platform_public_url }}
VITE_API_BASE_URL={{ platform_public_url }}

PLATFORM_VERSION={{ platform_version }}
LOG_LEVEL=INFO
LOG_FORMAT={{ log_format | default('console') }}
OBSERVABILITY_BACKEND={{ observability_backend | default('prometheus') }}
EDGE_PLATFORM_ADMIN_EMAIL={{ EDGE_PLATFORM_ADMIN_EMAIL | default(lookup('env', 'EDGE_PLATFORM_ADMIN_EMAIL') | default('', true), true) }}
EDGE_PLATFORM_ADMIN_PASSWORD={{ EDGE_PLATFORM_ADMIN_PASSWORD | default(lookup('env', 'EDGE_PLATFORM_ADMIN_PASSWORD') | default('', true), true) }}
