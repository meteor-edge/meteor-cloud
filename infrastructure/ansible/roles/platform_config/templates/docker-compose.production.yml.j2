services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    env_file:
      - /opt/edge-platform/config/platform.env
    volumes:
      - /opt/edge-platform/data/postgres:/var/lib/postgresql/data
    healthcheck:
      # $$ keeps expansion inside the container (env_file), not on the Compose host
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s
    networks:
      - platform

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
      - /opt/edge-platform/data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    networks:
      - platform

  backend:
    image: {{ backend_image }}
    restart: unless-stopped
    env_file:
      - /opt/edge-platform/config/platform.env
    environment:
      LOG_FORMAT: "{{ log_format | default('console') }}"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    networks:
      - platform

  frontend:
    image: {{ frontend_image }}
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_started
    networks:
      - platform

  traefik:
    image: traefik:v3.3
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/edge-platform/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - /opt/edge-platform/traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
      - /opt/edge-platform/traefik/acme.json:/acme.json
    depends_on:
      backend:
        condition: service_started
      frontend:
        condition: service_started
    networks:
      - platform

{% if (observability_enabled | default('false')) | bool %}
  node-exporter:
    image: prom/node-exporter:v1.8.2
    pid: host
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/host/root"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
    networks:
      - platform

  prometheus:
    image: prom/prometheus:v2.55.1
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.retention.time=15d"
    volumes:
      - /opt/edge-platform/src/infrastructure/observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /opt/edge-platform/data/prometheus:/prometheus
    depends_on:
      backend:
        condition: service_started
    networks:
      - platform

  loki:
    image: grafana/loki:3.3.2
    command: ["-config.file=/etc/loki/loki.yml"]
    volumes:
      - /opt/edge-platform/src/infrastructure/observability/loki.yml:/etc/loki/loki.yml:ro
    networks:
      - platform

  docker-socket-proxy:
    image: tecnativa/docker-socket-proxy:0.3.0
    environment:
      CONTAINERS: 1
      POST: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - docker_proxy

  alloy:
    image: grafana/alloy:v1.8.3
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
    volumes:
      - /opt/edge-platform/src/infrastructure/observability/config.alloy:/etc/alloy/config.alloy:ro
    depends_on:
      - loki
      - docker-socket-proxy
    networks:
      - platform
      - docker_proxy

  grafana:
    image: grafana/grafana:11.4.0
    environment:
      GF_SECURITY_ADMIN_USER: {{ grafana_admin_user }}
      GF_SECURITY_ADMIN_PASSWORD: {{ grafana_admin_password }}
    volumes:
      - /opt/edge-platform/src/infrastructure/observability/grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "127.0.0.1:3001:3000"
    depends_on:
      - prometheus
      - loki
    networks:
      - platform
{% endif %}

networks:
  platform:
    driver: bridge
{% if (observability_enabled | default('false')) | bool %}
  docker_proxy:
    internal: true
{% endif %}
